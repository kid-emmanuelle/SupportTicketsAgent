# NEVER commit the real .env file!

# ==========================================
# Snowflake connection
# ==========================================
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password          # prefer key-pair auth in production
SNOWFLAKE_ROLE=your_role
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=PROJECT_DB
SNOWFLAKE_SCHEMA=CURATED                  # default schema for general queries (optional)

# Optional: if using key-pair authentication instead of password
# SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ==========================================
# Snowflake Cortex OpenAI-compatible endpoint
# ==========================================
OPENAI_API_BASE=https://<account_identifier>.snowflakecomputing.com/api/v2/cortex/v1

# If your Snowflake setup requires a token for the OpenAI-compatible endpoint, put it here.
# Some setups use the same value as a Snowflake password/token; follow the course instructions.
# Only replace if needed.
OPENAI_API_KEY=<token>

# Default model name configured in your Snowflake account
LLM_MODEL=openai-gpt-5

# ==========================================
# Project settings
# ==========================================
CORTEX_SEARCH_DB=PROJECT_DB
CORTEX_SEARCH_SCHEMA=SERVICES
CORTEX_SEARCH_SERVICE=support_tickets_search_service

# Retrieval defaults
RETRIEVE_TOP_K=8

# ==========================================
# Cortex Agents (Threads + agent:run) REST API
# ==========================================
# Account URL for Snowflake REST APIs.
# Examples:
#   https://<account_identifier>.snowflakecomputing.com
#   https://<org>-<acct>.snowflakecomputing.com
SNOWFLAKE_ACCOUNT_URL=https://<account_identifier>.snowflakecomputing.com

# Authorization token for Snowflake REST APIs (PAT/OAuth/JWT).
# Used as: Authorization: Bearer <token>
SNOWFLAKE_REST_TOKEN=<token>

# Cortex Agent object location (created via sql/35_create_agent.sql)
CORTEX_AGENT_SCHEMA=APP
CORTEX_AGENT_NAME=support_tickets_agent

# Optional thread origin tag (Threads API: origin_application)
# ⚠️  IMPORTANT: Avoid reserved words like 'support' - they cause 390400 errors!
# Valid examples: tickets_app, helpdesk_app, myapp, test_app, etc.
CORTEX_ORIGIN_APPLICATION=tickets_app

# Opt-in for tests that call real Snowflake/Cortex endpoints
RUN_INTEGRATION_TESTS=0